# RocketRide
ROCKETRIDE_URI=http://localhost:5565
ROCKETRIDE_APIKEY=

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional fallback for Google AI Studio / Gemini Developer API.
# Prefer Vertex AI ADC for the hackathon Google Cloud credits path.
ROCKETRIDE_GEMINI_API_KEY=

# API
PORT=3001
HOST=0.0.0.0
KITCHENSCAN_EXTRACT_PIPELINE=../../pipelines/extract-ingredients.pipe
KITCHENSCAN_RECIPE_PIPELINE=../../pipelines/generate-recipes.pipe

# Optional demo switches. Keep false/blank for the connected judge demo.
KITCHENSCAN_DEMO_AI_FALLBACK=
EXPO_PUBLIC_DEMO_SCAN_FALLBACK=
EXPO_PUBLIC_DEMO_RECIPE_FALLBACK=
