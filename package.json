{
  "name": "kitchenscan",
  "version": "0.1.0",
  "private": true,
  "description": "Scan your kitchen, build an AI pantry, and cook with what you already have.",
  "scripts": {
    "dev:api": "pnpm --filter @kitchenscan/api dev",
    "dev:mobile": "pnpm --filter @kitchenscan/mobile start",
    "demo:check": "node scripts/check-demo-readiness.mjs",
    "demo:check:mobile": "node scripts/check-mobile-redesign.mjs",
    "rocketride:evidence": "node scripts/check-rocketride-evidence.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "hermes-parser": "^0.34.0"
  }
}
