NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgres://cooking:localdev@localhost:5432/cooking

# Redis — matches docker-compose.yml defaults
REDIS_URL=redis://localhost:6379

# Python inference service
# - When using docker compose: http://inference:8080 (service name resolves inside Docker)
# - When running locally without Docker: http://localhost:8080
INFERENCE_URL=http://localhost:8080

# Auth (Clerk) — create a free account at clerk.com
CLERK_SECRET_KEY=sk_test_xxx
