{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "API_URL": "http://localhost:3001",
        "INFERENCE_MODE": "cloud"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "API_URL": "https://api-staging.kitchenscan.app",
        "INFERENCE_MODE": "hybrid"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "API_URL": "https://api.kitchenscan.app",
        "INFERENCE_MODE": "hybrid"
      }
    }
  },
  "submit": {
    "production": {
      "ios": { "appleId": "your@email.com", "ascAppId": "XXXXXXXXXX" },
      "android": { "serviceAccountKeyPath": "./google-sa.json" }
    }
  }
}
